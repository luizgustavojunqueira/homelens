# Authentication token shared between server and agents
HOMELENS_AUTH_TOKEN=your_secure_random_token_here

# Server binding address (e.g. localhost:8080 for local, or ws://<ip>:8080/ws for agents)
HOMELENS_SERVER_ADDR=localhost:8080

# External host port for Docker Compose
HOMELENS_PORT=8080

# Agent sampling interval in seconds
HOMELENS_SECONDS_INTERVAL=5

# Optional: CORS allowed origin header (defaults to *)
# HOMELENS_CORS_ORIGIN=*

# Optional: SQLite database path (defaults to data/homelens.db)
# HOMELENS_DB_PATH=data/homelens.db
